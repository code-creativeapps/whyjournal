# Copy this file to .env and fill in your Supabase project credentials.
# Restart Metro with `npx expo start -c` after editing.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Pexels stock-image API. Get one at https://www.pexels.com/api/.
EXPO_PUBLIC_PEXELS_API_KEY=
